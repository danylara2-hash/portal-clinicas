{
  // Portal de clínicas · Dirige tu Clínica
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portal-clinicas",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  // Totales de cada clínica (foto:<clinica>) y usuarios (usuario:<email>).
  // Sin "id": Cloudflare crea el almacén KV automáticamente en el primer despliegue.
  "kv_namespaces": [{ "binding": "DATOS" }],
  "vars": {
    // Cloudflare Access (Zero Trust). Si se vacían, el portal solo enseña datos de ejemplo.
    "ACCESS_TEAM_DOMAIN": "dirigetuclinica.cloudflareaccess.com",
    "ACCESS_AUD": "73fdcf6be120da9c684b1cf1f76c991eed66b9debea7be9fadeeb73e2e5fd96c"
  }
  // Secreto (nunca aquí): SUBIR_TOKEN  ->  npx wrangler secret put SUBIR_TOKEN
}
